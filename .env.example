# 설정 예시 파일 — 이 파일을 복사해서 .env 를 만든다.
# .env 는 Git 에 올리지 않는다. 이 예시 파일에는 실제 비밀번호/계정 정보를 넣지 않는다.

# 채널 포트 (채널 번호는 1부터)
# ⚠️ 지금은 개발 단계라 로비/게임 1채널씩만 운영한다 (실 서비스 규모는 로비 2 / 게임 3 — CLAUDE.md 참고).
#    로비는 이 목록(LOBBY_PORTS)에 포트를 추가하고 해당 채널 프로세스만 새로 띄우면 된다 (코드 수정 불필요 —
#    CLAUDE.md "로비 채널 늘리기" 참고). 게임은 RPS_PORTS 에 포트를 추가하는 것 외에
#    src/common/constants.ts 의 RPS_CHANNEL_COUNT 도 함께 늘리고 재빌드해야 한다.
WATCHER_PORT=6001
LOBBY_PORTS=6011
RPS_PORTS=6021

# 좌석 예약(seat_reservation)의 publicAddress 에 쓰는 이 서버의 공개 주소.
# 개발 환경은 localhost 로 둔다. 운영 환경은 실제 도메인/IP 로 바꿔야 한다.
PUBLIC_HOST=localhost

# wss(TLS) — 운영 환경은 반드시 true. 개발 환경에서만 false(ws)
USE_TLS=false
TLS_CERT_PATH=
TLS_KEY_PATH=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6780

# MySQL — XAMPP 기본 root 계정은 비밀번호가 없다 (DB_PASSWORD= 로 비워 둠)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rps_game

# 관리자(Watcher) 로그인 계정 (Phase 7) — 운영 전 반드시 교체할 것
ADMIN_ID=admin
ADMIN_PASSWORD=changeme
