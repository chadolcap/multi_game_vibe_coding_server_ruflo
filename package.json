{
  "name": "server",
  "version": "1.0.0",
  "description": "실시간 2인 대전 보드게임(가위바위보) Colyseus 서버",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "dev": "npm run build && node dist/index.js lobby 1",
    "db:init": "npm run build && node dist/db/initDb.js",
    "start": "node dist/index.js",
    "start:watcher": "node dist/index.js watcher 1",
    "start:lobby1": "node dist/index.js lobby 1",
    "start:lobby2": "node dist/index.js lobby 2",
    "start:rps1": "node dist/index.js rps 1",
    "start:rps2": "node dist/index.js rps 2",
    "start:rps3": "node dist/index.js rps 3",
    "start:othello1": "node dist/index.js othello 1",
    "start:othello2": "node dist/index.js othello 2",
    "start:othello3": "node dist/index.js othello 3",
    "start:stepping1": "node dist/index.js stepping 1",
    "start:stepping2": "node dist/index.js stepping 2",
    "start:stepping3": "node dist/index.js stepping 3",
    "start:airhockey1": "node dist/index.js airhockey 1",
    "start:airhockey2": "node dist/index.js airhockey 2",
    "start:airhockey3": "node dist/index.js airhockey 3",
    "redis": "node scripts/run-redis.mjs",
    "redis:bg": "node scripts/run-redis.mjs --background",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:start:dev": "pm2 start ecosystem.config.cjs --only watcher,lobby_1,rps_1,othello_1,stepping_1,airhockey_1",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "test": "npm run build && node --test \"dist/**/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chadolcap/multi_game_vibe_coding_server.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/chadolcap/multi_game_vibe_coding_server/issues"
  },
  "homepage": "https://github.com/chadolcap/multi_game_vibe_coding_server#readme",
  "dependencies": {
    "@colyseus/core": "^0.18.15",
    "@colyseus/redis-driver": "^0.18.2",
    "@colyseus/redis-presence": "^0.18.4",
    "@colyseus/ws-transport": "^0.18.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "mysql2": "^3.24.4",
    "rufio": "^0.1.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "pm2": "^7.0.4",
    "typescript": "^7.0.2"
  }
}
